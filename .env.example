# Salin file ini menjadi .env dan sesuaikan nilainya sebelum deploy produksi.

DJANGO_SECRET_KEY=ganti-dengan-secret-key-acak-yang-panjang
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

RESTAURANT_BRAND_NAME=Rasa Nusantara

# Database produksi (isi otomatis oleh Render jika memakai Postgres Render).
# Kosongkan untuk tetap pakai SQLite lokal saat development.
DATABASE_URL=

# Email (kosongkan untuk tetap pakai console backend saat development)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=noreply@restoran.example.com

# WhatsApp via Fonnte (https://fonnte.com) - lihat panduan di README untuk cara daftar
WHATSAPP_NOTIFICATIONS_ENABLED=False
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_API_TOKEN=
